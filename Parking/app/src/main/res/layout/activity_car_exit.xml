<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rounded_corner_filter"
    tools:context=".activity.CarExitActivity">

    <LinearLayout
        android:id="@+id/login_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical"
        android:background="@drawable/rounded_corner_filter"
        android:padding="20dp">

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:baselineAligned="false"
            android:gravity="center"
            android:padding="5dp"
            android:text="@string/CarExit"
            android:textColor="@color/colorPrimary"
            android:textSize="35sp"
            android:background="@drawable/rounded_corner_filter"
            android:textStyle="bold" />
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.textfield.TextInputLayout
                android:layout_width="220dp"
                android:background="@drawable/rounded_corner_filter"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/entry_carnumber"
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@android:color/transparent"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:hint="@string/carnumber"
                    android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890"
                    android:inputType="textCapCharacters"
                    android:maxLines="10"
                    android:padding="10dp"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textColorHint="@color/colorPrimaryDark"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>
    <TextView
        android:id="@+id/carFindExit"
        android:layout_width="90dp"
        android:layout_height="55dp"
        android:background="@drawable/rounded_corner_filter"
        android:text="Find"
        android:textSize="20sp"
        android:gravity="center"
        android:textStyle="bold"
        android:layout_alignParentEnd="true"
        android:textColor="@color/colorPrimaryDark"/>
        <!--<View
                android:layout_width="fill_parent"
                android:layout_height="2px"
                android:background="@color/colorPrimaryDark" />-->
    </RelativeLayout>

        <TextView
            android:id="@+id/textview_in_date"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/rounded_corner_filter"
            android:layout_marginTop="7dp"
            android:text="In Date Time :"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/space_2"
            />
        <View
            android:layout_width="fill_parent"
            android:layout_height="2px"
            android:background="@color/colorPrimaryDark" />

        <TextView
            android:id="@+id/textview_car_type"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/rounded_corner_filter"
            android:layout_marginTop="7dp"
            android:text="Car Type : "
            android:gravity="center_vertical"
            android:paddingStart="@dimen/space_2"
            />
        <View
            android:layout_width="fill_parent"
            android:layout_height="2px"
            android:background="@color/colorPrimaryDark" />

        <TextView
            android:id="@+id/textview_car_load_type"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/rounded_corner_filter"
            android:layout_marginTop="7dp"
            android:text="Load Type : "
            android:gravity="center_vertical"
            android:paddingStart="@dimen/space_2"
            />
        <View
            android:layout_width="fill_parent"
            android:layout_height="2px"
            android:background="@color/colorPrimaryDark" />

        <TextView
            android:id="@+id/textview_out_date_time"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/rounded_corner_filter"
            android:layout_marginTop="7dp"
            android:text="Out Date Time :"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/space_2"
            />
        <View
            android:layout_width="fill_parent"
            android:layout_height="2px"
            android:background="@color/colorPrimaryDark" />

        <TextView
            android:id="@+id/textview_total_amount"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/rounded_corner_filter"
            android:layout_marginTop="7dp"
            android:text="Total Amount :"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/space_2"
            />
        <View
            android:layout_width="fill_parent"
            android:layout_height="2px"
            android:background="@color/colorPrimaryDark" />



        <Button
            android:id="@+id/btnCarSubmit"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_rounded_button"
            android:padding="3dp"
            android:text="@string/submit"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPrint"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_rounded_button"
            android:padding="3dp"
            android:text="@string/print"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>
    <include
        android:id="@+id/progress_bar"
        layout="@layout/progressbar"
        android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>