<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rounded_corner_filter"
    tools:context=".activity.DashBoardActivity">
    <LinearLayout
        android:id="@+id/topLinear"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@drawable/rounded_corner_filter"
        app:layout_constraintTop_toTopOf="parent">
        <!--    <ImageView
                android:layout_width="40dp"
                android:src="@drawable/ic_baseline_arrow_back_24"
                android:layout_height="match_parent"/>-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Parking Management"
            android:textStyle="bold"
            android:gravity="center"/>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topLinear"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="match_parent">
            <LinearLayout
                android:id="@+id/leartopimage"
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:background="@drawable/rounded_corner_filter"
                android:layout_height="150dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/space_5"
                    android:src="@drawable/logo"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:weightSum="2"
                android:background="@drawable/rounded_corner_filter"
                android:layout_height="120dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/btnNewEntry"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/space_5"
                    android:background="@drawable/rounded_corner_filter"
                    android:layout_weight="1">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">
                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center"
                        android:src="@drawable/car"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="Cars Entry"
                        android:textSize="18sp"
                        android:textColor="@color/colorPrimaryDark"
                        android:gravity="center"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:layout_width="2dp"
                    android:layout_height="90dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/colorPrimaryDark"/>
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnExit"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/space_5"
                    android:background="@drawable/rounded_corner_filter"
                    android:layout_weight="1">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_gravity="center"
                            android:src="@drawable/traffic"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:text="Cars Out"
                            android:textSize="18sp"
                            android:textColor="@color/colorPrimaryDark"
                            android:gravity="center"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:weightSum="2"
                android:visibility="visible"
                android:background="@drawable/rounded_corner_filter"
                android:layout_height="120dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/btnDeliveredOrder"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/space_5"
                    android:background="@drawable/rounded_corner_filter"
                    android:layout_weight="1">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/pd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentBottom="true"
                            android:gravity="center"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:text="Previous Day"
                            android:gravity="center"/>
                        <include
                            android:id="@+id/progress_bar"
                            layout="@layout/progressbar"
                            android:visibility="gone" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:layout_width="2dp"
                    android:layout_height="90dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/colorPrimaryDark"/>
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/space_5"
                    android:background="@drawable/rounded_corner_filter"
                    android:layout_weight="1">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/d"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentBottom="true"
                            android:gravity="center"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:text="ToDay"
                            android:gravity="center"/>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/print"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/printer"/>
            </LinearLayout>
            <TextView
                android:id="@+id/texview_login"
                android:layout_width="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:background="@drawable/rounded_corner_filter"
                android:layout_height="50dp"/>
            <TextView
                android:id="@+id/texview_logout"
                android:layout_width="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Log Out"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_height="wrap_content"/>
        </LinearLayout>



    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>